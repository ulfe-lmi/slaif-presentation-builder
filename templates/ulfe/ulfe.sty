% ---------------------------------------------------------------------------
% ULFE deck-facing macro contracts
% ---------------------------------------------------------------------------
%
% Keep presentation content in ulfe.tex as calls to these public macros. The
% coordinates, font sizes, colors, clipping, chart drawing, and overflow
% behavior live in this style file. Lower-level helpers below are template
% internals unless a public macro explicitly says to call them.
%
% ColorStyle names:
%   Red
%   Gray
%   RedWhiteGray
%   GrayWhite
%
% List syntax used by several macros:
%   item one; item two; item three
%
%   Semicolon is the item separator. Do not put semicolons inside an item unless
%   the item is protected or the macro is extended to support escaping. Long
%   items are expected to wrap in the template-provided text box; font sizes
%   should not be overridden in the deck.
%
% Pie chart item/value syntax:
%   Legend label/value; Legend label/value; ...
%
%   The slash separates the legend label from the numeric percentage. The value
%   is written as a plain number, for example 12.5 or 50, and the macro prints
%   the percent sign. Values are interpreted as percentages and should normally
%   sum to 100. Labels should not contain "/" or ";" unless the macro is later
%   extended with escaping.
%
% Grouped bar chart syntax:
%   Legend labels:
%     2021/22 | 2022/23 | 2023/24
%   Groups:
%     prva stopnja/4.3 \%|2.4 \%|2 \%;
%     druga stopnja/2.5 \%|4.4 \%|2 \%
%
%   The first slash separates the group name from that group's bar values. The
%   vertical bar separates bars within a group and legend entries. Values are
%   printed exactly as supplied, so units can be percentages, counts, EUR, or
%   other text. The bar height is calculated from the leading numeric part of
%   each value. Labels should not contain "|", ";", or "/" unless the macro is
%   later extended with escaping.
%
% Public slide macros:
%
%   \ULFETitleSlide{
%     colorStyle = {Red|Gray|RedWhiteGray|GrayWhite},
%     imageBackground = {asset-name-or-empty},
%     title = {...},
%     subtitle = {...},
%     lecturer = {...},
%     placeDate = {...}
%   }
%     Title/cover slide. The optional imageBackground is an asset file under
%     templates/ulfe/assets and is used by image-backed title variants.
%
%   \ULFECopyrightSlide{lecturer}{warning text}
%     Copyright warning slide. The warning text can be long; the macro keeps the
%     imported title and warning geometry rather than resizing fonts.
%
%   \ULFETocSlide{ColorStyle}{chapter title; chapter title; ...}
%     Table-of-contents slide. Item numbers are generated automatically from the
%     number of semicolon-separated chapter titles.
%
%   \ULFEChapterTitleSlideStyle{ColorStyle}{chapter title}
%     Chapter title divider. Long titles wrap in the style layer.
%
%   \ULFEPhotoLeftContentSlide{split}{title}{bullet items}{photo remark}{photo}
%   \ULFEPhotoRightContentSlide{split}{title}{bullet items}{photo remark}{photo}
%     Image/content slide. split is a decimal fraction of slide width, for
%     example 0.33, 0.5, or 0.66. The image preserves aspect ratio by centered
%     cover-cropping. bullet items use the semicolon list syntax above.
%
%   \ULFEQuoteSlideStyle{ColorStyle}{quote}
%     Quote slide. Long quotes wrap in the style layer without deck-side font
%     overrides.
%
%   \ULFEHeaderComparisonSlideStyle
%     {ColorStyle}{title}{left subtitle}{left bullet items}
%     {right subtitle}{right bullet items}
%     Two-column comparison slide. Both content arguments use semicolon-separated
%     red bullet lists by default.
%
%   \ULFEPlainTextSlide{title}{bullet items}
%     Plain bullet slide. The bullet list uses the semicolon list syntax.
%
%   \ULFEPieChartSlide{title}{legend/value; legend/value; ...}
%     Native pie chart slide. The macro calculates slice angles from percentages
%     in TeX, draws the pie and legend, and prints bold percentage labels.
%
%   \ULFEPieChartBulletsSlide
%     {title}{legend/value; legend/value; ...}{bullet items}
%     Native pie chart plus right-side bullet list. The chart data uses the same
%     semicolon and slash syntax as \ULFEPieChartSlide; bullet items use the
%     semicolon list syntax.
%
%   \ULFEGroupedBarChartSlide{title}{legend labels}{group specs}
%     Native grouped bar chart slide. Legend labels are separated with "|".
%     Group specs are separated with semicolons and each group is written as
%     group name/value|value|value. The supplied value text is printed above
%     the bar; its leading number drives the native bar height. Bar colors
%     repeat red, charcoal, and gray when there are more than three bars.
%
%   \ULFEDataTableSlide{title}{header cells}{row specs}
%     Native table slide. Header cells are separated with "|". Data rows are
%     separated with semicolons, and each row contains "|" separated cells.
%     Rows may be prefixed with "normal:", "indent:", "bold:", or "redbold:".
%     The table renderer supports 1-10 columns and 1-20 data rows.
%
%   \ULFEAreaBlocksSlide{text}{label/area; label/area; label/area; label/area}
%     Native area-block slide. The left red block contains non-bulleted text.
%     The four right-side blocks are generated from label/area pairs. The area
%     number can be written as fractions such as 0.25 or percentages such as 25;
%     only the relative values matter. Labels should not contain "/" or ";".
%
%   \ULFESplitRowsSlide{title}{left label/right label/split; ...}
%     Native horizontal split-row slide. Each row contains two blocks separated
%     by the imported gap. split is a number from 0 to 1; 0.2 means the left
%     block receives 20 percent of the available row width. Supports up to six
%     rows. The first two row color pairs repeat for rows 3-6.
%
%   \ULFEVerticalBarsSlide{title}{label/value; label/value; ...}
%     Native vertical bar slide. value is a number from 0 to 1 and controls the
%     bar height relative to the imported maximum height. Supports up to sixteen
%     bars. The first four bar colors repeat, and bars become narrower as more
%     bars are supplied. Labels should not contain "/" or ";".
%
%   \ULFEFinalGraySlide{title}{author and contact}
%   \ULFEFinalRedSlide{title}{author and contact}
%   \ULFEFinalPhotoSlide{title}{author and contact}
%     Final slide variants. All three share the same live-text geometry; only the
%     background treatment and footer style differ.
%
% Current legacy/showroom macros still present:
%   \ULFEWhiteLayout
%   \ULFEMetricPairSlide
%   \ULFEMetricTripleSlide
%   \ULFEMetricQuadSlide
%   \ULFEChartSlide{chart-body}
%   \ULFEChartTextSlide{chart-body}
%
% These legacy/showroom macros are not fully parameterized yet; keep using them
% only for the existing reconstruction until their slide families are clustered.
%
\newcommand{\ULFEBackground}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[fill=#1,draw=none] (current page.north west) rectangle (current page.south east);
  \end{tikzpicture}%
}

\newcommand{\ULFEPlaceImage}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt] at ([xshift=#1bp,yshift=-#2bp]current page.north west)
      {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\ULFEPlaceImageOpacity}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt,opacity=#6] at ([xshift=#1bp,yshift=-#2bp]current page.north west)
      {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\ULFEPlaceImageClip}[9]{%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([xshift=#1bp,yshift=-#2bp]current page.north west)}]
      \clip (0,0) rectangle (#3bp,-#4bp);
      \node[anchor=north west,inner sep=0pt] at (#7bp,#8bp)
        {\includegraphics[width=#5bp,height=#6bp]{assets/#9}};
    \end{scope}
  \end{tikzpicture}%
}

\newcommand{\ULFEPictureFrame}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[draw=none,fill=ULFEWhite] ([xshift=#1bp,yshift=-#2bp]current page.north west) rectangle
      ([xshift=#3bp,yshift=-#4bp]current page.north west);
  \end{tikzpicture}%
  \ULFEPlaceImage{#1}{#2}{#3-#1}{#4-#2}{#5}%
}

\newcommand{\ULFEText}[8]{%
  \begin{textblock*}{#3bp}(#1bp,#2bp)
    \begingroup
      \edef\ULFETextColor{#6}%
      \fontsize{#4pt}{#5pt}\selectfont\color{\ULFETextColor}%
      \begin{minipage}[t]{#3bp}#7 #8\end{minipage}%
    \endgroup
  \end{textblock*}%
}

\newcommand{\ULFEPlaceImageClipDim}[9]{%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([xshift=#1,yshift=-#2]current page.north west)}]
      \clip (0,0) rectangle (#3,-#4);
      \node[anchor=north west,inner sep=0pt] at (#7,#8)
        {\includegraphics[width=#5,height=#6]{assets/#9}};
    \end{scope}
  \end{tikzpicture}%
}

\newsavebox{\ULFEClipFitImageBox}
\newdimen\ULFEClipFitImageXDim
\newdimen\ULFEClipFitImageYDim
\newcommand{\ULFEPlaceImageClipCoverDim}[6]{%
  \sbox{\ULFEClipFitImageBox}{\includegraphics[width=#5]{assets/#6}}%
  \ifdim\dimexpr\ht\ULFEClipFitImageBox+\dp\ULFEClipFitImageBox\relax<#4
    \sbox{\ULFEClipFitImageBox}{\includegraphics[height=#4]{assets/#6}}%
  \fi
  \ULFEClipFitImageXDim=\dimexpr#3-\wd\ULFEClipFitImageBox\relax
  \divide\ULFEClipFitImageXDim by 2
  \ULFEClipFitImageYDim=\dimexpr\ht\ULFEClipFitImageBox+\dp\ULFEClipFitImageBox-#4\relax
  \divide\ULFEClipFitImageYDim by 2
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([xshift=#1,yshift=-#2]current page.north west)}]
      \clip (0,0) rectangle (#3,-#4);
      \node[anchor=north west,inner sep=0pt] at (\ULFEClipFitImageXDim,\ULFEClipFitImageYDim)
        {\usebox{\ULFEClipFitImageBox}};
    \end{scope}
  \end{tikzpicture}%
}

