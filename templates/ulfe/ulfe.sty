    \ULFEPieChartBulletsFromData{#2}%
    \ULFEText{623.3}{178}{272}{20}{26}{\ULFEColorStyleText{RedWhiteGray}}{\raggedright\sloppy\emergencystretch=1em}{\ULFERedBulletItems{#3}}%
    \ULFEFooter{RedWhiteGray}%
  }%
}

