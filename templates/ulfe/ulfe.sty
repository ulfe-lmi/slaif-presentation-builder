              --
              (869.8,{\fp_eval:n {224.2 + \l_ulfe_table_row_height_fp * (##1 - 1) + \l_ulfe_table_row_height_fp * .832}});
          }
        \seq_map_indexed_inline:Nn \l_ulfe_table_header_seq
          {
            \int_compare:nT { ##1 <= \l_ulfe_table_col_count_int }
              { \ulfe_table_cell:nnnn {0}{##1}{header}{##2} }
          }
        \int_zero:N \l_ulfe_table_row_index_int
        \seq_map_inline:Nn \l_ulfe_table_rows_seq
          {
            \tl_if_blank:nF {##1}
              {
                \int_incr:N \l_ulfe_table_row_index_int
                \int_compare:nT { \l_ulfe_table_row_index_int <= 20 }
                  { \ulfe_table_row:nn { \l_ulfe_table_row_index_int } {##1} }
              }
          }
      \end{scope}
    \end{tikzpicture}
  }

% Public native table slide.
% Arguments:
%   #1 slide title; pass an empty argument {} for a table-only slide.
%   #2 header cells separated with "|":
%      Plačilna skupina | Ženske | Moški
%   #3 data rows separated with semicolons. Each row contains "|" separated
%      cells and may start with one style prefix:
%      normal: ordinary row
%      indent: ordinary row with the imported first-column indentation
%      bold: bold row
%      redbold: bold red row
% Behavior:
%   The renderer calculates column count from the header, draws horizontal rules,
%   scales row height and font size for 1-20 data rows, and clips practical use
%   to the first 10 columns. It does not create rasterized table text.
\NewDocumentCommand{\ULFEDataTableSlide}{m m +m}
  {
    \ULFEFrame{\ULFEColorStyleCanvas{RedWhiteGray}}{
      \ULFETopLogo{\ULFEColorStyleTopLogo{RedWhiteGray}}
      \tl_if_blank:nF {#1}
        {
          \ULFEText{73.5}{122.5}{680.2}{32}{38}{\ULFEColorStyleTitle{RedWhiteGray}}{\raggedright\bfseries}{#1}
        }
      \ulfe_table_render:nn {#2}{#3}
      \ULFEFooter{RedWhiteGray}
    }
  }
