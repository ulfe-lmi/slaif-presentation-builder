% Public table-of-contents slide for slides 5-7.
% Arguments:
%   #1 ColorStyle name.
%   #2 semicolon-separated chapter titles.
% Behavior:
%   Item numbers are generated automatically from the list order. Up to eight
%   items are supported by the imported geometry. If fewer than five items are
%   passed, first-row item title regions expand vertically so longer titles
%   have more room without changing font size.
\NewDocumentCommand{\ULFETocSlide}{m >{\SplitList{;}}m}{%
  \ULFEFrame{\ULFEColorStyleBackground{#1}}{%
    \ULFETopLogo{\ULFEColorStyleTopLogo{#1}}%
    \ULFEText{66}{201}{174}{30}{35}{\ULFEColorStyleTitle{#1}}{\raggedright\bfseries}{Vsebina}%
    \ULFETocItemTotal=0\relax
    \ProcessList{#2}{\ULFETocCountItem}%
    \ifnum\ULFETocItemTotal<5\relax
      \renewcommand{\ULFETocFirstRowTitleHeight}{205}%
    \else
      \renewcommand{\ULFETocFirstRowTitleHeight}{85}%
    \fi
    \ULFETocItemIndex=0\relax
    \edef\ULFETocCurrentColor{\ULFEColorStyleCaption{#1}}%
    \ProcessList{#2}{\ULFETocProcessItem}%
    \ULFEFooter{#1}%
  }%
}

