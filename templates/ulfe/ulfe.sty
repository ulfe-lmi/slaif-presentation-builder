      { \int_set:Nn \l_ulfe_table_col_count_int {10} }
    \ulfe_table_count_rows:n {#2}
    \int_compare:nNnT { \l_ulfe_table_row_count_int } > {20}
      { \int_set:Nn \l_ulfe_table_row_count_int {20} }
    \fp_set:Nn \l_ulfe_table_row_height_fp
      { min(28.6, max(12.0, 252 / (\l_ulfe_table_row_count_int + 1))) }
    \fp_set:Nn \l_ulfe_table_font_size_fp
      { min(16, max(7.3, \l_ulfe_table_row_height_fp * .56)) }
    \fp_set:Nn \l_ulfe_table_line_height_fp
      { \l_ulfe_table_font_size_fp * 1.19 }
