% Pie slice drawing primitive used by the native chart parser.
% Arguments:
%   #1 fill color
%   #2 start angle in degrees
%   #3 end angle in degrees
%   #4 radius in bp
% This is intentionally ordinary TeX/TikZ syntax because TikZ polar coordinates
% conflict with LaTeX3's catcode for ":" inside expl3 code.
\newcommand{\ULFEPieSlicePath}[4]{%
  \path[fill=#1,draw=ULFEWhite,line width=1.25bp]
    (0,0) -- (#2:#4) arc (#2:#3:#4) -- cycle;
}

% Full-circle drawing primitive for a one-slice pie chart.
% Arguments:
%   #1 fill color
%   #2 radius in bp
\newcommand{\ULFEPieFullCirclePath}[2]{%
  \path[fill=#1,draw=ULFEWhite,line width=1.25bp] (0,0) circle[radius=#2];
}

% Percentage label primitive for native pie charts.
% Arguments:
%   #1 label angle in degrees
%   #2 numeric value without percent sign
% The label is intentionally bold to match the PowerPoint chart.
\newcommand{\ULFEPiePercentLabel}[2]{%
  \node[
    anchor=center,
    inner sep=0pt,
    text=ULFEChartInk,
    align=center,
    font=\fontsize{23pt}{27pt}\selectfont\bfseries
  ] at (#1:155) {#2\ \%};
}

\ExplSyntaxOn
\seq_new:N \l_ulfe_red_bullet_items_seq
% Shared red bullet parser.
% Argument:
%   #1 semicolon-separated bullet text:
%      First item; Second item; Third item
% This helper owns the red bullet marker, list spacing, and wrapping behavior
% for clustered slides that should render PowerPoint placeholder text as a
% live Beamer bullet list. Deck authors should not add raw itemize environments
% or manual font overrides around this macro.
\NewDocumentCommand{\ULFERedBulletItems}{m}{%
  \begin{ULFERedBulletList}
    \seq_set_split:Nnn \l_ulfe_red_bullet_items_seq {;} {#1}
    \seq_map_inline:Nn \l_ulfe_red_bullet_items_seq
      {\tl_if_blank:nF {##1} {\item \tl_trim_spaces:n {##1}}}
  \end{ULFERedBulletList}%
}
\ExplSyntaxOff

