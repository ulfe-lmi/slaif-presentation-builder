\cs_new_protected:Npn \ulfe_grouped_bar_extract_value:n #1
  {
    \regex_extract_once:nnNTF
      { [-+]? [0-9]+ ( \. [0-9]+ )? }
      {#1}
      \l_ulfe_grouped_bar_match_seq
      {
        \fp_set:Nn \l_ulfe_grouped_bar_value_fp
          { \seq_item:Nn \l_ulfe_grouped_bar_match_seq {1} }
      }
      { \fp_zero:N \l_ulfe_grouped_bar_value_fp }
  }

\cs_new_protected:Npn \ulfe_grouped_bar_parse_group:n #1
  {
    \tl_set:Nn \l_ulfe_grouped_bar_group_tl {#1}
    \tl_trim_spaces:N \l_ulfe_grouped_bar_group_tl
    \seq_set_split:NnV \l_ulfe_grouped_bar_group_pair_seq {/}
      \l_ulfe_grouped_bar_group_tl
    \tl_set:Nx \l_ulfe_grouped_bar_name_tl
      { \seq_item:Nn \l_ulfe_grouped_bar_group_pair_seq {1} }
    \tl_set:Nx \l_ulfe_grouped_bar_values_tl
      { \seq_item:Nn \l_ulfe_grouped_bar_group_pair_seq {2} }
    \tl_trim_spaces:N \l_ulfe_grouped_bar_name_tl
    \tl_trim_spaces:N \l_ulfe_grouped_bar_values_tl
    \seq_set_split:NnV \l_ulfe_grouped_bar_values_seq {|}
      \l_ulfe_grouped_bar_values_tl
  }

\cs_new_protected:Npn \ulfe_grouped_bar_prepare:nn #1#2
  {
    \seq_set_split:Nnn \l_ulfe_grouped_bar_legend_seq {|} {#1}
    \seq_set_split:Nnn \l_ulfe_grouped_bar_groups_seq {;} {#2}
    \int_zero:N \l_ulfe_grouped_bar_group_count_int
    \int_set:Nn \l_ulfe_grouped_bar_bar_count_int
      { \seq_count:N \l_ulfe_grouped_bar_legend_seq }
    \fp_zero:N \l_ulfe_grouped_bar_max_fp
    \seq_map_inline:Nn \l_ulfe_grouped_bar_groups_seq
      {
        \tl_set:Nn \l_ulfe_grouped_bar_group_tl {##1}
        \tl_trim_spaces:N \l_ulfe_grouped_bar_group_tl
        \tl_if_blank:VF \l_ulfe_grouped_bar_group_tl
          {
            \int_incr:N \l_ulfe_grouped_bar_group_count_int
            \ulfe_grouped_bar_parse_group:n {##1}
            \int_compare:nT
              { \seq_count:N \l_ulfe_grouped_bar_values_seq > \l_ulfe_grouped_bar_bar_count_int }
              {
                \int_set:Nn \l_ulfe_grouped_bar_bar_count_int
                  { \seq_count:N \l_ulfe_grouped_bar_values_seq }
              }
            \seq_map_inline:Nn \l_ulfe_grouped_bar_values_seq
              {
                \tl_set:Nn \l_ulfe_grouped_bar_value_tl {####1}
                \tl_trim_spaces:N \l_ulfe_grouped_bar_value_tl
                \exp_args:NV \ulfe_grouped_bar_extract_value:n
                  \l_ulfe_grouped_bar_value_tl
                \fp_compare:nT
                  { \l_ulfe_grouped_bar_value_fp > \l_ulfe_grouped_bar_max_fp }
                  { \fp_set_eq:NN \l_ulfe_grouped_bar_max_fp \l_ulfe_grouped_bar_value_fp }
              }
          }
      }
    \int_compare:nNnT \l_ulfe_grouped_bar_group_count_int < {1}
      { \int_set:Nn \l_ulfe_grouped_bar_group_count_int {1} }
    \int_compare:nNnT \l_ulfe_grouped_bar_bar_count_int < {1}
      { \int_set:Nn \l_ulfe_grouped_bar_bar_count_int {1} }
    \fp_compare:nT { \l_ulfe_grouped_bar_max_fp <= 0 }
      { \fp_set:Nn \l_ulfe_grouped_bar_max_fp {1} }
    \tl_set:Nn \l_ulfe_grouped_bar_value_font_tl
      { \fontsize{13.5pt}{16pt}\selectfont }
    \int_compare:nNnT \l_ulfe_grouped_bar_bar_count_int > {3}
      {
        \tl_set:Nn \l_ulfe_grouped_bar_value_font_tl
          { \fontsize{11.5pt}{13.5pt}\selectfont }
      }
  }

\cs_new_protected:Npn \ulfe_grouped_bar_set_color:n #1
  {
    \int_case:nnF { \int_mod:nn { #1 - 1 } {3} }
      {
        {0}{ \tl_set:Nn \l_ulfe_grouped_bar_color_tl {ULFEBrandRed} }
        {1}{ \tl_set:Nn \l_ulfe_grouped_bar_color_tl {ULFECharcoal} }
        {2}{ \tl_set:Nn \l_ulfe_grouped_bar_color_tl {ULFEChartGrayMedium} }
      }
      { \tl_set:Nn \l_ulfe_grouped_bar_color_tl {ULFEBrandRed} }
  }

\cs_new_protected:Npn \ulfe_grouped_bar_draw_group:nn #1#2
  {
    \ulfe_grouped_bar_parse_group:n {#2}
    \fp_set:Nn \l_ulfe_grouped_bar_total_width_fp
      {
        min(
          \l_ulfe_grouped_bar_group_step_fp * .62,
          \l_ulfe_grouped_bar_bar_count_int * 35.5
            + max(\l_ulfe_grouped_bar_bar_count_int - 1, 0)
              * \l_ulfe_grouped_bar_gap_fp
        )
      }
    \fp_set:Nn \l_ulfe_grouped_bar_width_fp
      {
        max(
          5,
          (\l_ulfe_grouped_bar_total_width_fp
            - max(\l_ulfe_grouped_bar_bar_count_int - 1, 0)
              * \l_ulfe_grouped_bar_gap_fp)
          / \l_ulfe_grouped_bar_bar_count_int
        )
      }
    \fp_set:Nn \l_ulfe_grouped_bar_group_left_fp
      {
        77 + (#1 - 1) * \l_ulfe_grouped_bar_group_step_fp
        + (\l_ulfe_grouped_bar_group_step_fp - \l_ulfe_grouped_bar_total_width_fp) / 2
      }
    \seq_map_indexed_inline:Nn \l_ulfe_grouped_bar_values_seq
      {
        \tl_set:Nn \l_ulfe_grouped_bar_value_tl {##2}
        \tl_trim_spaces:N \l_ulfe_grouped_bar_value_tl
        \exp_args:NV \ulfe_grouped_bar_extract_value:n
          \l_ulfe_grouped_bar_value_tl
        \fp_set:Nn \l_ulfe_grouped_bar_height_fp
          { 195.5 * \l_ulfe_grouped_bar_value_fp / \l_ulfe_grouped_bar_max_fp }
        \fp_set:Nn \l_ulfe_grouped_bar_top_fp
          { 410.5 - \l_ulfe_grouped_bar_height_fp }
        \fp_set:Nn \l_ulfe_grouped_bar_x_fp
          {
            \l_ulfe_grouped_bar_group_left_fp
            + (##1 - 1) * (\l_ulfe_grouped_bar_width_fp + \l_ulfe_grouped_bar_gap_fp)
          }
        \ulfe_grouped_bar_set_color:n {##1}
        \path[fill=\l_ulfe_grouped_bar_color_tl]
          ({\fp_use:N \l_ulfe_grouped_bar_x_fp},410.5)
          rectangle
          ({\fp_eval:n { \l_ulfe_grouped_bar_x_fp + \l_ulfe_grouped_bar_width_fp }},
           {\fp_use:N \l_ulfe_grouped_bar_top_fp});
        \node[
          anchor=south,
          inner~sep=0pt,
          text=ULFEChartInk,
          font=\l_ulfe_grouped_bar_value_font_tl,
          align=center,
          text~width=\fp_eval:n { max(34, min(70, \l_ulfe_grouped_bar_width_fp + 16)) }bp
        ] at
          ({\fp_eval:n { \l_ulfe_grouped_bar_x_fp + \l_ulfe_grouped_bar_width_fp / 2 }},
           {\fp_eval:n { \l_ulfe_grouped_bar_top_fp - 6 }})
          {\l_ulfe_grouped_bar_value_tl};
      }
    \node[
      anchor=north,
      inner~sep=0pt,
      text=ULFECharcoal,
      font=\fontsize{14pt}{17pt}\selectfont,
      align=center,
      text~width=\fp_eval:n { \l_ulfe_grouped_bar_group_step_fp * .78 }bp
    ] at
      ({\fp_eval:n {77 + (#1 - .5) * \l_ulfe_grouped_bar_group_step_fp}},416)
      {\l_ulfe_grouped_bar_name_tl};
  }

\cs_new_protected:Npn \ulfe_grouped_bar_draw_legend:
  {
    \fp_set:Nn \l_ulfe_grouped_bar_legend_step_fp
      { min(160, 807 / \l_ulfe_grouped_bar_bar_count_int) }
    \fp_set:Nn \l_ulfe_grouped_bar_legend_label_width_fp
      { max(42, \l_ulfe_grouped_bar_legend_step_fp - 17) }
    \seq_map_indexed_inline:Nn \l_ulfe_grouped_bar_legend_seq
      {
        \tl_set:Nn \l_ulfe_grouped_bar_label_tl {##2}
        \tl_trim_spaces:N \l_ulfe_grouped_bar_label_tl
        \ulfe_grouped_bar_set_color:n {##1}
        \path[fill=\l_ulfe_grouped_bar_color_tl]
          ({\fp_eval:n {116.5 + (##1 - 1) * \l_ulfe_grouped_bar_legend_step_fp}},477.5)
          rectangle
          ({\fp_eval:n {123.5 + (##1 - 1) * \l_ulfe_grouped_bar_legend_step_fp}},484.5);
        \node[
          anchor=west,
          inner~sep=0pt,
          text=ULFECharcoal,
          font=\fontsize{12pt}{14pt}\selectfont,
          align=left,
          text~width=\fp_use:N \l_ulfe_grouped_bar_legend_label_width_fp bp
        ] at
          ({\fp_eval:n {127 + (##1 - 1) * \l_ulfe_grouped_bar_legend_step_fp}},481)
          {\l_ulfe_grouped_bar_label_tl};
      }
  }

\cs_new_protected:Npn \ulfe_grouped_bar_chart:nn #1#2
  {
    \ulfe_grouped_bar_prepare:nn {#1}{#2}
    \fp_set:Nn \l_ulfe_grouped_bar_group_step_fp
      { 807 / \l_ulfe_grouped_bar_group_count_int }
    \fp_set:Nn \l_ulfe_grouped_bar_gap_fp
      { min(9.5, max(3, \l_ulfe_grouped_bar_group_step_fp * .047)) }
    \begin{tikzpicture}[remember~picture,overlay]
      \begin{scope}[shift={(current~page.north~west)},x=1bp,y=-1bp]
        \draw[ULFEChartAxisRule,line~width=.4bp] (77,410.5) -- (884,410.5);
        \int_zero:N \l_ulfe_grouped_bar_group_index_int
        \seq_map_inline:Nn \l_ulfe_grouped_bar_groups_seq
          {
            \tl_set:Nn \l_ulfe_grouped_bar_group_tl {##1}
            \tl_trim_spaces:N \l_ulfe_grouped_bar_group_tl
            \tl_if_blank:VF \l_ulfe_grouped_bar_group_tl
              {
                \int_incr:N \l_ulfe_grouped_bar_group_index_int
                \ulfe_grouped_bar_draw_group:nn
                  { \l_ulfe_grouped_bar_group_index_int } {##1}
              }
          }
        \ulfe_grouped_bar_draw_legend:
      \end{scope}
    \end{tikzpicture}
  }

% Public grouped bar chart slide.
% Arguments:
%   #1 slide title.
%   #2 legend labels separated with "|", for example:
%      2021/22 | 2022/23 | 2023/24
%   #3 semicolon-separated group specs. Each group is:
%      group name/value|value|value
%      Example:
%      prva stopnja/4.3 \%|2.4 \%|2 \%;
%      druga stopnja/2.5 \%|4.4 \%|2 \%
% Behavior:
%   Values are printed exactly as supplied so units remain deck content. The
%   leading numeric part of each value drives the bar height. The chart scales
%   to the largest supplied value, supports variable group and bar counts, and
%   repeats the imported red, charcoal, gray bar-color sequence for bars beyond
%   the first three.
\NewDocumentCommand{\ULFEGroupedBarChartSlide}{m m +m}
  {
    \ULFEFrame{\ULFEColorStyleCanvas{RedWhiteGray}}{%
      \ULFETopLogo{\ULFEColorStyleTopLogo{RedWhiteGray}}%
      \ULFEText{73.5}{122.5}{760}{32}{38}{\ULFEColorStyleTitle{RedWhiteGray}}{\raggedright\bfseries\sloppy\emergencystretch=1em}{#1}%
      \ulfe_grouped_bar_chart:nn {#2}{#3}%
      \ULFEFooter{RedWhiteGray}%
    }%
  }
\ExplSyntaxOff

