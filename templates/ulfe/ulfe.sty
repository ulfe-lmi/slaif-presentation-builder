% Public pie chart with bullets slide for slide 20.
% Arguments:
%   #1 slide title.
%   #2 semicolon-separated legend/value pairs, for example:
%      1. metoda/12.5; 2. metoda/12.5; 3. metoda/25; 4. metoda/50
%   #3 semicolon-separated bullet items.
% Behavior:
%   The chart calculation, percentage labels, legend, title geometry, and
%   right-side red bullet list are owned by the style layer. The title gets a
%   wider header region than the imported placeholder so longer titles do not
%   force font shrinking; long bullet items wrap inside the right text column
%   without deck-side font or layout overrides.
\NewDocumentCommand{\ULFEPieChartBulletsSlide}{m m +m}{%
  \ULFEFrame{\ULFEColorStyleCanvas{RedWhiteGray}}{%
    \ULFETopLogo{\ULFEColorStyleTopLogo{RedWhiteGray}}%
