% Public image-left/content-right slide for slide 11-like layouts.
% Arguments:
%   #1 split fraction of slide width, e.g. 0.33, 0.5, 0.66
%   #2 title text
%   #3 content text, normally semicolon-separated red bullet items
%   #4 photo remark/caption
%   #5 photo asset filename under templates/ulfe/assets
% Behavior:
%   The image fills the left side by centered cover-cropping, preserving aspect
%   ratio. The content side is computed from the split. Long titles can push the
%   bullet area downward while retaining the imported font sizes.
\NewDocumentCommand{\ULFEPhotoLeftContentSlide}{m m +m m m}{%
  \pgfmathsetlength{\ULFEPhotoSplitXDim}{960bp*(#1)}%
  \ULFEPhotoContentXDim=\dimexpr\ULFEPhotoSplitXDim+76bp\relax
  \ULFEPhotoContentWDim=\dimexpr960bp-\ULFEPhotoContentXDim-57.3bp\relax
  \ULFEPhotoLeftSetContentY{\ULFEPhotoContentWDim}{#2}%
  \ULFEFrame{\ULFEColorStyleCanvas{RedWhiteGray}}{%
    \ULFEPlaceImageClipCoverDim{0bp}{0bp}{\ULFEPhotoSplitXDim}{540bp}{\ULFEPhotoSplitXDim}{#5}%
    \ULFETopLogo{\ULFEColorStyleTopLogo{RedWhiteGray}}%
    \ULFETextDim{\ULFEPhotoContentXDim}{82.5bp}{\ULFEPhotoContentWDim}{32}{35}{\ULFEColorStyleTitle{RedWhiteGray}}{\raggedright\bfseries\sloppy\emergencystretch=1em}{#2}%
    \ULFETextDim{\ULFEPhotoContentXDim}{\ULFEPhotoContentY}{\ULFEPhotoContentWDim}{20}{32}{\ULFEColorStyleText{RedWhiteGray}}{\raggedright\sloppy\emergencystretch=1em}{#3}%
    \ULFETextDim{\ULFEPhotoContentXDim}{489bp}{\ULFEPhotoContentWDim}{14}{16}{\ULFEColorStyleCaption{RedWhiteGray}}{\raggedright\sloppy\emergencystretch=1em}{#4}%
    \ULFEFooter{RedWhiteGray}%
  }%
}

% Public content-left/image-right slide for slide 12-like layouts.
% Arguments:
%   #1 split fraction of slide width, e.g. 0.33, 0.5, 0.66
%   #2 title text
%   #3 content text, normally semicolon-separated red bullet items
%   #4 photo remark/caption
%   #5 photo asset filename under templates/ulfe/assets
% Behavior:
%   The image fills the right side by centered cover-cropping, preserving aspect
%   ratio. The left text region and right image region are computed from the
%   split. Deck content stays semantic; no direct image placement belongs there.
\NewDocumentCommand{\ULFEPhotoRightContentSlide}{m m +m m m}{%
  \pgfmathsetlength{\ULFEPhotoSplitXDim}{960bp*(#1)}%
  \ULFEPhotoTextXDim=66bp
  \ULFEPhotoTextWDim=\dimexpr\ULFEPhotoSplitXDim-\ULFEPhotoTextXDim-28.5bp\relax
  \ULFEPhotoImageWDim=\dimexpr960bp-\ULFEPhotoSplitXDim-64.5bp\relax
  \ULFEPhotoCaptionXDim=\dimexpr\ULFEPhotoSplitXDim+7bp\relax
  \ULFEPhotoRightSetContentY{\ULFEPhotoTextWDim}{#2}%
  \ULFEFrame{\ULFEColorStyleCanvas{RedWhiteGray}}{%
    \ULFEPlaceImageClipCoverDim{\ULFEPhotoSplitXDim}{96bp}{\ULFEPhotoImageWDim}{376bp}{\ULFEPhotoImageWDim}{#5}%
    \ULFETopLogo{\ULFEColorStyleTopLogo{RedWhiteGray}}%
    \ULFETextDim{\ULFEPhotoTextXDim}{73bp}{\ULFEPhotoTextWDim}{32}{34}{\ULFEColorStyleTitle{RedWhiteGray}}{\raggedright\bfseries\sloppy\emergencystretch=1em}{#2}%
    \ULFETextDim{\ULFEPhotoTextXDim}{\ULFEPhotoContentY}{\ULFEPhotoTextWDim}{20}{26}{\ULFEColorStyleText{RedWhiteGray}}{\raggedright\sloppy\emergencystretch=1em}{#3}%
    \ULFETextDim{\ULFEPhotoCaptionXDim}{488bp}{230.3bp}{14}{16}{\ULFEColorStyleCaption{RedWhiteGray}}{\raggedright\sloppy\emergencystretch=1em}{#4}%
    \ULFEFooter{RedWhiteGray}%
  }%
}

