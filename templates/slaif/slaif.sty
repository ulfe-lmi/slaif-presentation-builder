\newcommand{\SlaifStatisticPanels}[1]{%
  \SlaifStatisticPanelsReset
  \pgfkeys{/SlaifStatisticPanels,#1}%
  \SlaifStatisticPanelCount=0
  \def\SlaifStatistic##1##2##3{%
    \global\advance\SlaifStatisticPanelCount by 1
  }%
  \SlaifStatisticPanelItems
  \SlaifStatisticPanelIndex=0
  \def\SlaifStatistic##1##2##3{%
    \global\advance\SlaifStatisticPanelIndex by 1
    \pgfmathsetmacro{\SlaifStatisticPanelWidth}{(\SlaifStatisticPanelTotalWidth - (\the\SlaifStatisticPanelCount - 1) * \SlaifStatisticPanelGap) / \the\SlaifStatisticPanelCount}%
    \pgfmathsetmacro{\SlaifStatisticPanelLeft}{\SlaifStatisticPanelX + (\the\SlaifStatisticPanelIndex - 1) * (\SlaifStatisticPanelWidth + \SlaifStatisticPanelGap)}%
    \pgfmathsetmacro{\SlaifStatisticPanelRight}{\SlaifStatisticPanelLeft + \SlaifStatisticPanelWidth}%
    \pgfmathsetmacro{\SlaifStatisticPanelBottom}{\SlaifStatisticPanelY + \SlaifStatisticPanelHeight}%
    \pgfmathsetmacro{\SlaifStatisticDescriptionX}{\SlaifStatisticPanelLeft + 10.800}%
    \pgfmathsetmacro{\SlaifStatisticDescriptionWidth}{\SlaifStatisticPanelWidth - 21.600}%
    \pgfmathsetmacro{\SlaifStatisticValueY}{\SlaifStatisticPanelY + 18.000}%
    \pgfmathsetmacro{\SlaifStatisticTitleY}{\SlaifStatisticPanelY + 82.800}%
    \pgfmathsetmacro{\SlaifStatisticDescriptionY}{\SlaifStatisticPanelY + 111.600}%
    \drawshape{fill=SlaifSurface,draw=SlaifBorder,line width=0.750bp,rounded corners=6bp}{rectangle}{\SlaifStatisticPanelLeft}{\SlaifStatisticPanelY}{\SlaifStatisticPanelRight}{\SlaifStatisticPanelBottom}%
    \placetextbox{\SlaifStatisticPanelLeft}{\SlaifStatisticValueY}{\SlaifStatisticPanelWidth}{77.853}{49.680}{57.132}{{\RobotoCondensed{}\bfseries \parbox{\SlaifStatisticPanelWidth bp}{\centering ##1}}}{SlaifAccentTeal}%
    \placetextbox{\SlaifStatisticPanelLeft}{\SlaifStatisticTitleY}{\SlaifStatisticPanelWidth}{18.166}{10.920}{12.558}{{\RobotoCondensed{}\bfseries \parbox{\SlaifStatisticPanelWidth bp}{\centering ##2}}}{SlaifInk}%
    \placetextbox{\SlaifStatisticDescriptionX}{\SlaifStatisticDescriptionY}{\SlaifStatisticDescriptionWidth}{57.380}{10.920}{12.558}{{\RobotoCondensed{} \parbox{\SlaifStatisticDescriptionWidth bp}{\centering ##3}}}{SlaifMutedText}%
  }%
  \SlaifStatisticPanelItems
}

