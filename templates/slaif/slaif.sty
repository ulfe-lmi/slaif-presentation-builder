\newcommand{\SlaifFootnotePanelReset}{%
  \SlaifFootnotePanelCenterTextfalse
  \def\SlaifFootnotePanelX{39.600}%
  \def\SlaifFootnotePanelBottom{503.165}%
  \def\SlaifFootnotePanelWidth{882.000}%
  \def\SlaifFootnotePanelPaddingX{21.600}%
  \def\SlaifFootnotePanelPaddingY{9.000}%
  \def\SlaifFootnotePanelRadius{6.000}%
  \def\SlaifFootnotePanelFill{SlaifPanelBlue}%
  \def\SlaifFootnotePanelDraw{none}%
  \def\SlaifFootnotePanelLineWidth{0.000}%
  \def\SlaifFootnotePanelTextColor{SlaifInk}%
  \def\SlaifFootnotePanelFontSize{10.920}%
  \def\SlaifFootnotePanelLineHeight{12.558}%
}

\pgfkeys{
  /SlaifFootnotePanel/.is family,
  /SlaifFootnotePanel,
  rightColumn/.style={
    x=457.200,
    bottom=504.948,
    width=464.400,
  },
  panelCaption/.style={
    x=39.600,
    width=882.000,
    bottom=503.165,
    paddingX=21.600,
    paddingY=12.558,
    fill=SlaifPanelBlue,
    textColor=SlaifMutedText,
    fontSize=10.920,
    lineHeight=12.558,
    centerText,
  },
  x/.store in=\SlaifFootnotePanelX,
  bottom/.store in=\SlaifFootnotePanelBottom,
  width/.store in=\SlaifFootnotePanelWidth,
  paddingX/.store in=\SlaifFootnotePanelPaddingX,
  paddingY/.store in=\SlaifFootnotePanelPaddingY,
  radius/.store in=\SlaifFootnotePanelRadius,
  fill/.store in=\SlaifFootnotePanelFill,
  draw/.store in=\SlaifFootnotePanelDraw,
  lineWidth/.store in=\SlaifFootnotePanelLineWidth,
  textColor/.store in=\SlaifFootnotePanelTextColor,
  fontSize/.store in=\SlaifFootnotePanelFontSize,
  lineHeight/.store in=\SlaifFootnotePanelLineHeight,
  centerText/.code={\SlaifFootnotePanelCenterTexttrue},
}

\newcommand{\SlaifFootnotePanel}[2][]{%
  \SlaifFootnotePanelReset
  \pgfkeys{/SlaifFootnotePanel,#1}%
  \pgfmathsetmacro{\SlaifFootnotePanelContentWidth}{\SlaifFootnotePanelWidth - 2 * \SlaifFootnotePanelPaddingX}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[
      anchor=south west,
      fill=\SlaifFootnotePanelFill,
      draw=\SlaifFootnotePanelDraw,
      line width=\SlaifFootnotePanelLineWidth bp,
      rounded corners=\SlaifFootnotePanelRadius bp,
      inner xsep=\SlaifFootnotePanelPaddingX bp,
      inner ysep=\SlaifFootnotePanelPaddingY bp
    ] at ([xshift=\SlaifFootnotePanelX bp,yshift=-\SlaifFootnotePanelBottom bp]current page.north west) {%
      \begin{minipage}{\SlaifFootnotePanelContentWidth bp}
        \begingroup\color{\SlaifFootnotePanelTextColor}\fontsize{\SlaifFootnotePanelFontSize pt}{\SlaifFootnotePanelLineHeight pt}\selectfont\RobotoCondensed{}%
          \ifSlaifFootnotePanelCenterText
            \centering #2\par
          \else
            #2%
          \fi
        \endgroup
      \end{minipage}%
    };
  \end{tikzpicture}%
}

\newcommand{\SlaifPillReset}{%
  \def\SlaifPillX{0.000}%
  \def\SlaifPillY{0.000}%
  \def\SlaifPillWidth{122.400}%
  \def\SlaifPillHeight{27.360}%
  \def\SlaifPillRadius{6.000}%
  \def\SlaifPillFill{SlaifPanelBlue}%
  \def\SlaifPillTextColor{SlaifPrimaryTeal}%
  \def\SlaifPillFontSize{9.360}%
  \def\SlaifPillLineHeight{10.764}%
}

\pgfkeys{
  /SlaifPill/.is family,
  /SlaifPill,
  inactive/.style={
    fill=SlaifPanelBlue,
    textColor=SlaifPrimaryTeal,
  },
  active/.style={
    fill=SlaifGreen,
    textColor=SlaifWhite,
  },
  x/.store in=\SlaifPillX,
  y/.store in=\SlaifPillY,
  width/.store in=\SlaifPillWidth,
  height/.store in=\SlaifPillHeight,
  radius/.store in=\SlaifPillRadius,
  fill/.store in=\SlaifPillFill,
  textColor/.store in=\SlaifPillTextColor,
  fontSize/.store in=\SlaifPillFontSize,
  lineHeight/.store in=\SlaifPillLineHeight,
}

\newcommand{\SlaifPill}[2][]{%
  \SlaifPillReset
  \pgfkeys{/SlaifPill,inactive,#1}%
  \ifSlaifColoredPanelsMeasuring
    \SlaifColoredPanelsCandidateBottom=\dimexpr\SlaifPillY bp + \SlaifPillHeight bp\relax
    \SlaifColoredPanelsReportBottomDim{\SlaifColoredPanelsCandidateBottom}%
  \else
    \pgfmathsetmacro{\SlaifPillCenterX}{\SlaifPillX + \SlaifPillWidth / 2}%
    \pgfmathsetmacro{\SlaifPillCenterY}{\SlaifPillY + \SlaifPillHeight / 2}%
    \begin{tikzpicture}[remember picture,overlay]
      \node[
        anchor=center,
        fill=\SlaifPillFill,
        draw=none,
        rounded corners=\SlaifPillRadius bp,
        minimum width=\SlaifPillWidth bp,
        minimum height=\SlaifPillHeight bp,
        inner sep=0pt,
        align=center,
        text width=\SlaifPillWidth bp
      ] at ([xshift=\SlaifPillCenterX bp,yshift=-\SlaifPillCenterY bp]current page.north west) {%
        \begingroup\color{\SlaifPillTextColor}\fontsize{\SlaifPillFontSize pt}{\SlaifPillLineHeight pt}\selectfont\RobotoCondensed{}\bfseries #2\endgroup
      };
    \end{tikzpicture}%
  \fi
}

\newcommand{\SlaifPanelPill}[2][]{%
  \pgfmathsetmacro{\SlaifPanelPillX}{\SlaifColoredPanelLeft + 18.000}%
  \pgfmathsetmacro{\SlaifPanelPillWidth}{\SlaifColoredPanelWidth - 36.000}%
  \SlaifPill[
    x=\SlaifPanelPillX,
    y=208.800,
    width=\SlaifPanelPillWidth,
    height=32.400,
    #1
  ]{#2}%
}

