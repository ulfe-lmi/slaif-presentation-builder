\newcommand{\ColoredPanels}[1]{%
  \SlaifColoredPanelsReset
  \def\SlaifColoredPanelItems{#1}%
  \SlaifColoredPanelCount=0
  \RenewDocumentCommand{\ColoredPanel}{O{} m m m m}{%
    \global\advance\SlaifColoredPanelCount by 1
  }%
  \SlaifColoredPanelItems
  \SlaifColoredPanelsApplyAutoLayout
  \global\SlaifColoredPanelsHasMeasuredBottomfalse
  \global\SlaifColoredPanelsMeasuredBottom=0bp
  \SlaifColoredPanelsMeasuringtrue
  \SlaifColoredPanelIndex=0
  \begingroup
    \let\placeimage\SlaifMeasureNoopFive
    \let\placeimageopacity\SlaifMeasureNoopSix
    \let\drawshape\SlaifMeasureNoopSix
    \let\placetextbox\SlaifMeasureNoopEight
    \RenewDocumentCommand{\ColoredPanel}{O{} m m m m}{%
      \global\advance\SlaifColoredPanelIndex by 1
      \SlaifColoredPanelsSetupPanelGeometry
      ##4%
    }%
    \SlaifColoredPanelItems
  \endgroup
  \SlaifColoredPanelsMeasuringfalse
  \ifSlaifColoredPanelsHasMeasuredBottom
    \SlaifColoredPanelsCandidateBottom=\dimexpr\SlaifColoredPanelsMeasuredBottom + \SlaifColoredPanelsBottomPadding bp\relax
    \SlaifPanelMeasureContentHeight=\dimexpr\SlaifColoredPanelsCandidateBottom - \SlaifColoredPanelsY bp\relax
    \edef\SlaifColoredPanelsMeasuredHeightPt{\strip@pt\SlaifPanelMeasureContentHeight}%
    \pgfmathsetmacro{\SlaifColoredPanelsHeight}{\SlaifColoredPanelsMeasuredHeightPt * 0.99626401}%
  \fi
  \SlaifBarColorSequence{\the\SlaifColoredPanelCount}{\SlaifColoredPanelColorSequence}%
  \SlaifColoredPanelIndex=0
  \RenewDocumentCommand{\ColoredPanel}{O{} m m m m}{%
    \global\advance\SlaifColoredPanelIndex by 1
    \SlaifColoredPanelsSetupPanelGeometry
    \def\SlaifColoredPanelColor{##1}%
    \if\relax\detokenize{##1}\relax
      \SlaifSelectColorFromSequence{\SlaifColoredPanelColorSequence}{\the\SlaifColoredPanelIndex}{\SlaifColoredPanelColor}%
    \fi
    \drawshape{fill=SlaifWhite,draw=SlaifBorder,line width=0.750bp,rounded corners=6bp}{rectangle}{\SlaifColoredPanelLeft}{\SlaifColoredPanelsY}{\SlaifColoredPanelRight}{\SlaifColoredPanelBottom}%
    \drawshape{fill=\SlaifColoredPanelColor,draw=none}{rectangle}{\SlaifColoredPanelLeft}{\SlaifColoredPanelsY}{\SlaifColoredPanelRight}{\SlaifColoredPanelHeaderBottom}%
    \placetextbox{\SlaifColoredPanelLeft}{\SlaifColoredPanelHeaderTitleY}{\SlaifColoredPanelWidth}{\SlaifColoredPanelsHeaderTitleHeight}{\SlaifColoredPanelsHeaderTitleFontSize}{\SlaifColoredPanelsHeaderTitleLineHeight}{{\RobotoCondensed{}\bfseries \parbox{\SlaifColoredPanelWidth bp}{\centering ##2}}}{SlaifWhite}%
    \if\relax\detokenize{##3}\relax\else
      \placetextbox{\SlaifColoredPanelInnerX}{\SlaifColoredPanelSubtitleY}{\SlaifColoredPanelInnerWidth}{\SlaifColoredPanelsSubtitleHeight}{\SlaifColoredPanelsSubtitleFontSize}{\SlaifColoredPanelsSubtitleLineHeight}{{\RobotoCondensed{}\bfseries \parbox{\SlaifColoredPanelInnerWidth bp}{\centering ##3}}}{SlaifInk}%
    \fi
    \if\relax\detokenize{##5}\relax\else
      \placetextbox{\SlaifColoredPanelInnerX}{\SlaifColoredPanelMiniFooterY}{\SlaifColoredPanelInnerWidth}{\SlaifColoredPanelsMiniFooterHeight}{\SlaifColoredPanelsMiniFooterFontSize}{\SlaifColoredPanelsMiniFooterLineHeight}{{\RobotoCondensed{}\bfseries \parbox{\SlaifColoredPanelInnerWidth bp}{\centering ##5}}}{SlaifPrimaryTeal}%
    \fi
    ##4%
  }%
  \SlaifColoredPanelItems
}

