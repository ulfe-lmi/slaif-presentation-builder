\newcommand{\placeimage}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt] at ([xshift=#1bp,yshift=-#2bp]current page.north west) {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\placeqrimage}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt] at ([xshift=#1bp,yshift=-#2bp]current page.north west) {\includegraphics[interpolate=false,width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\placeimageopacity}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt,opacity=#6] at ([xshift=#1bp,yshift=-#2bp]current page.north west) {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\placeimagerounded}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={([xshift=#1bp,yshift=-#2bp]current page.north west)}]
      \clip[rounded corners=#5bp] (0,0) rectangle (#3bp,-#4bp);
      \node[anchor=north west,inner sep=0pt] at (0,0) {\includegraphics[width=#3bp,height=#4bp]{assets/#6}};
    \end{scope}
  \end{tikzpicture}%
}

\newcommand{\placetextbox}[8]{%
  \begin{textblock*}{#3bp}(#1bp,#2bp)
    \begingroup\color{#8}\fontsize{#5pt}{#6pt}\selectfont #7\endgroup
  \end{textblock*}%
}

\newcommand{\drawrect}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[#1] ([xshift=#2bp,yshift=-#3bp]current page.north west) rectangle ([xshift=#4bp,yshift=-#5bp]current page.north west);
  \end{tikzpicture}%
}

\newcommand{\drawellipse}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[#1] ([xshift=#2bp,yshift=-#3bp]current page.north west) ellipse [x radius=#4bp, y radius=#5bp];
  \end{tikzpicture}%
}

\newcommand{\drawshape}[6]{%
  \ifstrequal{#2}{ellipse}{\drawellipse{#1}{#3}{#4}{#5}{#6}}{\drawrect{#1}{#3}{#4}{#5}{#6}}%
}

