\newcommand{\SlaifNoTextSlideReset}{%
  \let\SlaifNoTextTitle\@empty
  \let\SlaifNoTextSubtitle\@empty
  \let\SlaifNoTextStatistics\@empty
  \let\SlaifNoTextConclusionTitle\@empty
  \let\SlaifNoTextConclusionText\@empty
}

\pgfkeys{
  /SlaifNoTextSlide/.is family,
  /SlaifNoTextSlide,
  title/.store in=\SlaifNoTextTitle,
  subtitle/.store in=\SlaifNoTextSubtitle,
  statistics/.store in=\SlaifNoTextStatistics,
  conclusionTitle/.store in=\SlaifNoTextConclusionTitle,
  conclusionText/.store in=\SlaifNoTextConclusionText,
}

