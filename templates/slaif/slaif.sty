\newcommand{\placeimage}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt] at ([xshift=#1bp,yshift=-#2bp]current page.north west) {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\placeimageopacity}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=0pt,opacity=#6] at ([xshift=#1bp,yshift=-#2bp]current page.north west) {\includegraphics[width=#3bp,height=#4bp]{assets/#5}};
  \end{tikzpicture}%
}

\newcommand{\placetextbox}[8]{%
  \begin{textblock*}{#3bp}(#1bp,#2bp)
    \begingroup\color{#8}\fontsize{#5pt}{#6pt}\selectfont #7\endgroup
  \end{textblock*}%
}

\newcommand{\drawrect}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[#1] ([xshift=#2bp,yshift=-#3bp]current page.north west) rectangle ([xshift=#4bp,yshift=-#5bp]current page.north west);
  \end{tikzpicture}%
}

\newcommand{\drawellipse}[5]{%
  \begin{tikzpicture}[remember picture,overlay]
    \path[#1] ([xshift=#2bp,yshift=-#3bp]current page.north west) ellipse [x radius=#4bp, y radius=#5bp];
  \end{tikzpicture}%
}

\newcommand{\drawshape}[6]{%
  \ifstrequal{#2}{ellipse}{\drawellipse{#1}{#3}{#4}{#5}{#6}}{\drawrect{#1}{#3}{#4}{#5}{#6}}%
}

\makeatletter
\newcommand{\SlaifTitleReset}{%
  \let\SlaifTitleTitle\@empty
  \let\SlaifTitleAuthor\@empty
  \let\SlaifTitleInstitution\@empty
  \let\SlaifTitleRole\@empty
  \let\SlaifTitleEvent\@empty
  \let\SlaifTitleSubtitle\@empty
  \let\SlaifTitleDate\@empty
}

\pgfkeys{
  /SlaifTitleSlide/.is family,
  /SlaifTitleSlide,
  title/.store in=\SlaifTitleTitle,
  author/.store in=\SlaifTitleAuthor,
  institution/.store in=\SlaifTitleInstitution,
  role/.store in=\SlaifTitleRole,
  event/.store in=\SlaifTitleEvent,
  subtitle/.store in=\SlaifTitleSubtitle,
  date/.store in=\SlaifTitleDate,
}

\newcommand{\SlaifTitleAppend}[3]{%
  \ifx#3\@empty\else
    \ifx#1\@empty
      \let#1#3%
    \else
      \expandafter\g@addto@macro\expandafter#1\expandafter{#2#3}%
    \fi
  \fi
}

\newcommand{\SlaifTitleBuildLines}{%
  \let\SlaifTitleAuthorLine\@empty
  \let\SlaifTitleEventLine\@empty
  \SlaifTitleAppend{\SlaifTitleAuthorLine}{}{\SlaifTitleAuthor}%
  \SlaifTitleAppend{\SlaifTitleAuthorLine}{ · }{\SlaifTitleInstitution}%
  \SlaifTitleAppend{\SlaifTitleAuthorLine}{  · }{\SlaifTitleRole}%
  \SlaifTitleAppend{\SlaifTitleEventLine}{}{\SlaifTitleEvent}%
  \SlaifTitleAppend{\SlaifTitleEventLine}{  ·  }{\SlaifTitleSubtitle}%
}

\newcommand{\SlaifTitleSlide}[1]{%
  \SlaifTitleReset
  \pgfkeys{/SlaifTitleSlide,#1}%
  \SlaifTitleBuildLines
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]\fill[SlaifWhite] (current page.south west) rectangle (current page.north east);\end{tikzpicture}
    \placeimage{0.000}{8.365}{960.000}{487.470}{image1_crop_r6512.jpg}
    \drawshape{fill=SlaifBlack, fill opacity=0.400,draw=none}{rectangle}{0.000}{8.365}{960.000}{495.835}
    \placeimage{44.369}{122.125}{292.767}{219.778}{image2.png}
    \placeimage{0.000}{0.000}{960.000}{540.000}{image3.png}
    \drawshape{draw=none}{rectangle}{66.000}{500.500}{282.000}{529.250}
    \drawshape{draw=none}{rectangle}{318.000}{500.500}{642.000}{529.250}
    \drawshape{draw=none}{rectangle}{678.000}{500.500}{894.000}{529.250}
    \placetextbox{388.706}{147.014}{505.294}{188.000}{44.000}{47.000}{{\RobotoCondensed{}\bfseries \parbox{505.294bp}{\raggedright \SlaifTitleTitle}}}{SlaifWhite}
    \placetextbox{388.706}{279.100}{505.294}{32.000}{18.000}{20.700}{{\RobotoCondensed{}\bfseries \parbox{505.294bp}{\raggedright \SlaifTitleAuthorLine}}}{SlaifWhite}
    \placetextbox{388.706}{308.400}{505.294}{32.000}{16.000}{18.400}{{\RobotoCondensed{}\itshape \parbox{505.294bp}{\raggedright \SlaifTitleEventLine}}}{SlaifWhite}
    \placetextbox{73.500}{511.000}{216.000}{28.500}{9.200}{11.224}{{\RobotoCondensed{}\SlaifTitleDate}}{SlaifWhite}
  \end{frame}%
}
\makeatother
