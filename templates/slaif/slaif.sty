\newcommand{\SlaifBarColorForIndex}[3]{%
  \def#3{SlaifMutedText}%
  \ifnum#2<4
    \ifnum#1=1\def#3{SlaifAccentTeal}\fi
    \ifnum#1=2\def#3{SlaifGreenDark}\fi
    \ifnum#1=3\def#3{SlaifGreen}\fi
  \else\ifnum#2=4
    \ifnum#1=1\def#3{SlaifAccentTeal}\fi
    \ifnum#1=2\def#3{SlaifPrimaryTeal}\fi
    \ifnum#1=3\def#3{SlaifGreenDark}\fi
    \ifnum#1=4\def#3{SlaifGreen}\fi
  \else
    \ifnum#2=5
      \ifnum#1=1\def#3{SlaifAccentTeal}\fi
      \ifnum#1=2\def#3{SlaifPrimaryTeal}\fi
      \ifnum#1=3\def#3{SlaifGreenDark}\fi
      \ifnum#1=4\def#3{SlaifGreen}\fi
      \ifnum#1=5\def#3{SlaifMutedText}\fi
    \else
      \ifnum#1<3\def#3{SlaifAccentTeal}\fi
      \ifnum#2=6
        \ifnum#1=3\def#3{SlaifPrimaryTeal}\fi
        \ifnum#1=4\def#3{SlaifGreenDark}\fi
        \ifnum#1=5\def#3{SlaifGreen}\fi
        \ifnum#1>5\def#3{SlaifMutedText}\fi
      \else\ifnum#2=7
        \ifnum#1>2\ifnum#1<5\def#3{SlaifPrimaryTeal}\fi\fi
        \ifnum#1=5\def#3{SlaifGreenDark}\fi
        \ifnum#1=6\def#3{SlaifGreen}\fi
        \ifnum#1>6\def#3{SlaifMutedText}\fi
      \else\ifnum#2=8
        \ifnum#1>2\ifnum#1<5\def#3{SlaifPrimaryTeal}\fi\fi
        \ifnum#1>4\ifnum#1<7\def#3{SlaifGreenDark}\fi\fi
        \ifnum#1=7\def#3{SlaifGreen}\fi
        \ifnum#1>7\def#3{SlaifMutedText}\fi
      \else
        \ifnum#1>2\ifnum#1<5\def#3{SlaifPrimaryTeal}\fi\fi
        \ifnum#1>4\ifnum#1<7\def#3{SlaifGreenDark}\fi\fi
        \ifnum#1>6\ifnum#1<9\def#3{SlaifGreen}\fi\fi
        \ifnum#1>8\def#3{SlaifMutedText}\fi
      \fi\fi\fi
    \fi
  \fi\fi
}

\newcommand{\SlaifAppendBarColor}[2]{%
  \ifx#1\@empty
    \edef#1{#2}%
  \else
    \edef#1{#1,#2}%
  \fi
}

\newcommand{\SlaifBarColorSequence}[2]{%
  \let#2\@empty
  \SlaifBarColorSequenceIndex=1
  \loop
    \ifnum\SlaifBarColorSequenceIndex<\numexpr#1+1\relax
      \SlaifBarColorForIndex{\the\SlaifBarColorSequenceIndex}{#1}{\SlaifBarColorSequenceItem}%
      \SlaifAppendBarColor{#2}{\SlaifBarColorSequenceItem}%
      \advance\SlaifBarColorSequenceIndex by 1
  \repeat
}

\newcommand{\SlaifSelectColorFromSequence}[3]{%
  \def#3{SlaifMutedText}%
  \foreach \SlaifSequenceColor [count=\SlaifSequenceIndex] in #1 {%
    \ifnum\SlaifSequenceIndex=#2\relax
      \xdef#3{\SlaifSequenceColor}%
    \fi
  }%
}

\newcommand{\SlaifSliderTable}[1]{%
  \SlaifSliderReset
  \pgfkeys{/SlaifSliderTable,wide,#1}%
  \SlaifSliderCount=0
  \SlaifSliderMax=0
  \foreach \SlaifSliderLabel/\SlaifSliderValue in \SlaifSliderRows {%
    \global\advance\SlaifSliderCount by 1
    \ifnum\SlaifSliderValue>\SlaifSliderMax
      \global\SlaifSliderMax=\SlaifSliderValue
    \fi
  }%
  \SlaifBarColorSequence{\the\SlaifSliderCount}{\SlaifSliderColorSequence}%
  \foreach \SlaifSliderLabel/\SlaifSliderValue [count=\SlaifSliderIndex] in \SlaifSliderRows {%
    \SlaifSelectColorFromSequence{\SlaifSliderColorSequence}{\SlaifSliderIndex}{\SlaifSliderColor}%
    \pgfmathsetmacro{\SlaifSliderRowY}{\SlaifSliderY + (\SlaifSliderIndex - 1) * \SlaifSliderRowStep}%
    \pgfmathsetmacro{\SlaifSliderLabelY}{\SlaifSliderRowY + \SlaifSliderLabelYOffset}%
    \pgfmathsetmacro{\SlaifSliderBarBottom}{\SlaifSliderRowY + \SlaifSliderBarHeight}%
    \pgfmathsetmacro{\SlaifSliderTrackRight}{\SlaifSliderBarX + \SlaifSliderBarWidth}%
    \pgfmathsetmacro{\SlaifSliderBarRight}{\SlaifSliderBarX + \SlaifSliderBarWidth * \SlaifSliderValue / \the\SlaifSliderMax}%
    \pgfmathsetmacro{\SlaifSliderValueX}{\SlaifSliderBarRight + \SlaifSliderValueGap}%
    \pgfmathsetmacro{\SlaifSliderValueY}{\SlaifSliderRowY + \SlaifSliderValueYOffset}%
    \placetextbox{\SlaifSliderLabelX}{\SlaifSliderLabelY}{\SlaifSliderLabelWidth}{\SlaifSliderLabelHeight}{\SlaifSliderLabelFontSize}{\SlaifSliderLabelLineHeight}{{\RobotoCondensed{}\bfseries \parbox{\SlaifSliderLabelWidth bp}{\raggedright \SlaifSliderLabel}}}{SlaifInk}%
    \drawshape{fill=\SlaifSliderTrackColor,draw=none}{rectangle}{\SlaifSliderBarX}{\SlaifSliderRowY}{\SlaifSliderTrackRight}{\SlaifSliderBarBottom}%
    \drawshape{fill=\SlaifSliderColor,draw=none}{rectangle}{\SlaifSliderBarX}{\SlaifSliderRowY}{\SlaifSliderBarRight}{\SlaifSliderBarBottom}%
    \placetextbox{\SlaifSliderValueX}{\SlaifSliderValueY}{\SlaifSliderValueWidth}{\SlaifSliderValueHeight}{\SlaifSliderValueFontSize}{\SlaifSliderValueLineHeight}{{\RobotoCondensed{}\bfseries \parbox{\SlaifSliderValueWidth bp}{\raggedright \SlaifSliderValue}}}{\SlaifSliderColor}%
  }%
}

