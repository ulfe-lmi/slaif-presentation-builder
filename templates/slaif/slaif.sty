\newcommand{\SlaifPanelTextItem}[1]{}

\newcommand{\SlaifCenteredItems}[2][]{%
  \SlaifCenteredItemsReset
  \pgfkeys{/SlaifCenteredItems,#1}%
  \SlaifCenteredItemCount=0
  \def\SlaifPanelTextItem##1{%
    \global\advance\SlaifCenteredItemCount by 1
  }%
  #2%
  \ifSlaifColoredPanelsMeasuring
    \pgfmathsetmacro{\SlaifPanelCenteredItemsBottom}{\SlaifPanelCenteredItemsY + (\the\SlaifCenteredItemCount - 1) * \SlaifPanelCenteredItemsRowStep + \SlaifPanelCenteredItemsItemHeight}%
    \SlaifColoredPanelsCandidateBottom=\dimexpr\SlaifPanelCenteredItemsBottom bp\relax
    \SlaifColoredPanelsReportBottomDim{\SlaifColoredPanelsCandidateBottom}%
  \else
    \SlaifCenteredItemIndex=0
    \def\SlaifPanelTextItem##1{%
      \global\advance\SlaifCenteredItemIndex by 1
      \pgfmathsetmacro{\SlaifPanelCenteredItemY}{\SlaifPanelCenteredItemsY + (\the\SlaifCenteredItemIndex - 1) * \SlaifPanelCenteredItemsRowStep}%
      \placetextbox{\SlaifCenteredItemsX}{\SlaifPanelCenteredItemY}{\SlaifCenteredItemsWidth}{\SlaifPanelCenteredItemsItemHeight}{\SlaifPanelCenteredItemsFontSize}{\SlaifPanelCenteredItemsLineHeight}{{\RobotoCondensed{} \parbox{\SlaifCenteredItemsWidth bp}{\centering ##1}}}{\SlaifPanelCenteredItemsColor}%
    }%
    #2%
  \fi
}

\newcommand{\SlaifPanelCenteredItems}[2][]{%
  \SlaifCenteredItems[
    x=\SlaifColoredPanelInnerX,
    width=\SlaifColoredPanelInnerWidth,
    #1
  ]{#2}%
}

